# ==============================================================================
# BuddyAi - Environment Variables Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure the values according to your environment:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Prisma SQLite)
# ------------------------------------------------------------------------------
# Default is a local SQLite database file in the project directory.
# Zero external database server or cloud service required.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. NextAuth.js Authentication
# ------------------------------------------------------------------------------
# NEXTAUTH_URL: The canonical URL of your BuddyAi web application.
# For local development: http://localhost:3005
# For production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3005"

# NEXTAUTH_SECRET: A strong random string used to hash tokens and sign session cookies.
# Generate one via terminal: openssl rand -base64 32
NEXTAUTH_SECRET="buddyai_super_secret_session_key_replace_in_prod"

# ------------------------------------------------------------------------------
# 3. Security & BYO-Model Key Encryption (AES-256-GCM)
# ------------------------------------------------------------------------------
# ENCRYPTION_SECRET: 32-byte secret key used to encrypt and decrypt your API keys
# stored in SQLite. Keep this private and persistent.
ENCRYPTION_SECRET="buddyai_aes_256_secret_key_32bytes"

# ------------------------------------------------------------------------------
# 4. Telegram Bot Long-Polling & Webhook (Optional)
# ------------------------------------------------------------------------------
# LOCAL_WEBHOOK_URL: Used by the background Telegram daemon (npm run telegram:bot)
# to forward incoming Telegram updates to your local BuddyAi API route.
# Defaults to http://localhost:3005/api/telegram/webhook
LOCAL_WEBHOOK_URL="http://localhost:3005/api/telegram/webhook"
